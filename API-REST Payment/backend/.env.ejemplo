# Copiá este archivo como ".env" (en la misma carpeta) y completá los
# valores reales. El ".env" real nunca se sube al repositorio (ver
# .gitignore).

# --- SEMyT (sitio 1) ---
SEMYT_LOGIN=
SEMYT_USUARIO=
SEMYT_PASSWORD=

# --- Municipalidad de Villa María / SIGI (sitio 2, login CiDi) ---
SIGI_LOGIN=
SIGI_PROCESO=
CIDI_USUARIO=
CIDI_PASSWORD=

# True = ves el navegador trabajar, False = corre en segundo plano.
MODO_VISIBLE=False

# Rol a seleccionar al loguear en CiDi (texto exacto del botón).
ROL_SESION=

# Fecha desde la que existe "EM" (multas electrónicas) en SEMyT, dd/mm/aaaa.
FECHA_INICIO_EM=

# Cada cuánto se dispara "actualizar pagos" en modo automático.
# Vacío = default de producción (60 minutos).
INTERVALO_PAGOS_MINUTOS=60
